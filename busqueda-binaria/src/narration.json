  "seconds": 44.25,
  "missing": false,
  "cues": [
   {
    "t0": 0.0,
    "t1": 2.82,
    "text": "Llevemos esto a Java, primero con un ciclo."
   },
   {
    "t0": 3.28,
    "t1": 6.64,
    "text": "low empieza en 0 y high en la última posición."
   },
   {
    "t0": 7.16,
    "t1": 11.48,
    "text": "Mientras low sea menor o igual que high, todavía hay intervalo."
   },
   {
    "t0": 11.96,
    "t1": 16.44,
    "text": "Calculo mid como low más la mitad de la distancia entre low y high;"
   },
   {
    "t0": 16.84,
    "t1": 19.98,
    "text": "así evito que la suma se desborde con arreglos gigantes."
   },
   {
    "t0": 20.66,
    "t1": 23.9,
    "text": "Si el dato en mid es el objetivo, devuelvo su posición."
   },
   {
    "t0": 24.44,
    "t1": 29.06,
    "text": "Si es menor, descarto la izquierda: low pasa a ser mid + 1."
   },
   {
    "t0": 29.06,
    "t1": 32.26,
    "text": "Si no, high pasa a ser mid − 1."
   },
   {
    "t0": 32.94,
    "t1": 37.78,
    "text": "Ese + 1 y ese − 1 son la clave: sacan a mid del intervalo,"
   },
   {
    "t0": 37.84,
    "t1": 41.68,
    "text": "así que en cada vuelta se encoge, y el ciclo siempre termina."
   },
   {
    "t0": 42.1,
    "t1": 44.08,
    "text": "Y si se vacía, devuelvo −1."
   }
  ],
  "marks": {
