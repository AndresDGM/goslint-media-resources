  "cues": [
   {
    "t0": 0.0,
    "t1": 1.27,
    "text": "¿Qué tan rápido es esto?"
   },
   {
    "t0": 1.85,
    "t1": 7.73,
    "text": "La complejidad algorítmica describe cómo crece el trabajo de un algoritmo cuando crecen los datos."
   },
   {
    "t0": 8.31,
    "t1": 10.75,
    "text": "Llamemos n a la cantidad de elementos."
   },
   {
    "t0": 11.41,
    "t1": 16.49,
    "text": "La búsqueda lineal, la de uno por uno, puede llegar a revisar los n elementos:"
   },
   {
    "t0": 16.95,
    "t1": 18.11,
    "text": "es O(n)."
   },
   {
    "t0": 18.61,
    "t1": 21.87,
    "text": "La binaria parte el problema a la mitad en cada paso,"
   },
   {
    "t0": 22.13,
    "t1": 26.09,
    "text": "y el número de veces que puedes partir n a la mitad hasta llegar a uno"
   },
   {
    "t0": 26.09,
    "t1": 28.61,
    "text": "es el logaritmo en base 2 de n."
   },
   {
    "t0": 28.61,
    "t1": 31.33,
    "text": "Por eso es O(log n)."
   }
  ],
  "marks": {
   "rapido": 0.21,
   "complejidad": 2.15,
   "n": 8.75,
   "lineal": 11.47,
   "on": 17.02,
