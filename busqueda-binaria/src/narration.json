  "missing": false,
  "cues": [
   {
    "t0": 0.0,
    "t1": 1.41,
    "text": "Pongámoslas a competir:"
   },
   {
    "t0": 1.73,
    "t1": 7.33,
    "text": "la misma lista ordenada y el mismo objetivo, cerca del 75 %."
   },
   {
    "t0": 7.33,
