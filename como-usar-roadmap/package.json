{
  "name": "goslint-como-usar-roadmap",
  "version": "1.0.0",
  "private": true,
  "description": "Video de bienvenida 03 de Goslint: cómo usar el roadmap (React + Remotion, pixel art, narración ElevenLabs)",
  "scripts": {
    "studio": "node ../commons/scripts/sync-public.mjs && remotion studio",
    "render": "node ../commons/scripts/sync-public.mjs && bash scripts/render.sh",
    "still": "node ../commons/scripts/sync-public.mjs && remotion still ComoUsarRoadmap out/still.png",
    "typecheck": "tsc --noEmit",
    "assets:audio": "python3 ../commons/scripts/make_sfx.py && node scripts/dump_timeline.mjs && python3 scripts/make_music.py",
    "qa": "bash ../commons/scripts/qa.sh out/goslint-como-usar-roadmap.mp4 out/qa",
    "timeline": "node scripts/dump_timeline.mjs",
    "subtitles": "node scripts/dump_timeline.mjs && python3 scripts/make_srt.py",
    "reels": "node ../commons/scripts/sync-public.mjs && bash scripts/render_reels.sh",
    "commons": "node ../commons/scripts/sync-public.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@remotion/cli": "4.0.534",
    "@remotion/media-utils": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
