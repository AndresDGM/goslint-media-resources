  "cues": [
   {
    "t0": 0.0,
    "t1": 2.07,
    "text": "Ahora, ¿por dónde entras tú?"
   },
   {
    "t0": 2.07,
    "t1": 3.67,
    "text": "Si nunca has programado,"
   },
   {
