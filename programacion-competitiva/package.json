{
  "name": "goslint-programacion-competitiva",
  "version": "1.0.0",
  "private": true,
  "description": "Video de bienvenida 02 de Goslint: ¿qué es la programación competitiva? (React + Remotion, pixel art, narración ElevenLabs)",
  "scripts": {
    "studio": "remotion studio",
    "render": "bash scripts/render.sh",
    "still": "remotion still ProgramacionCompetitiva out/still.png",
    "typecheck": "tsc --noEmit",
    "assets:audio": "python3 scripts/make_sfx.py && node scripts/dump_timeline.mjs && python3 scripts/make_music.py",
    "qa": "bash scripts/qa.sh out/goslint-programacion-competitiva.mp4 out/qa",
    "timeline": "node scripts/dump_timeline.mjs",
    "subtitles": "node scripts/dump_timeline.mjs && python3 scripts/make_srt.py",
    "test:soluciones": "python3 scripts/check_solutions.py",
    "photos": "python3 scripts/prepare_photos.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@remotion/cli": "4.0.534",
    "@remotion/media-utils": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
