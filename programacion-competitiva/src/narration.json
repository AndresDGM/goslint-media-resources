  "seconds": 37.74,
  "missing": false,
  "cues": [
   {
    "t0": 0.0,
    "t1": 6.78,
    "text": "Ahora hablemos de una de las competencias universitarias más importantes del mundo: la ICPC."
   },
   {
    "t0": 6.78,
    "t1": 10.94,
    "text": "Son las siglas de International Collegiate Programming Contest,"
   },
   {
    "t0": 10.94,
    "t1": 14.62,
    "text": "una competencia internacional para estudiantes universitarios."
   },
   {
    "t0": 14.62,
    "t1": 17.58,
    "text": "Y su formato tiene una particularidad:"
   },
   {
    "t0": 17.58,
    "t1": 19.58,
    "text": "equipos de tres estudiantes…"
   },
   {
    "t0": 19.58,
    "t1": 22.78,
    "text": "¡que comparten un solo computador!"
   },
