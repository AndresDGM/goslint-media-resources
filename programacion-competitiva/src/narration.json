  "missing": false,
  "cues": [
   {
    "t0": 0.0,
    "t1": 5.09,
    "text": "¿Te imaginas tener cinco horas para resolver un montón de problemas de programación,"
   },
   {
    "t0": 5.09,
    "t1": 7.73,
    "text": "compartir un solo computador con tus compañeros"
   },
   {
    "t0": 7.73,
    "t1": 10.93,
    "text": "y competir contra universidades de todo el mundo?"
   },
   {
    "t0": 10.93,
    "t1": 14.37,
    "text": "¡Pues de eso se trata la programación competitiva!"
   },
   {
    "t0": 14.37,
    "t1": 18.69,
    "text": "Pero ¿qué es exactamente? ¿Cómo funcionan estas competencias?"
   },
   {
    "t0": 18.69,
    "t1": 21.25,
    "text": "¿Y cómo puedes participar desde la UCEVA?"
   },
   {
    "t0": 21.25,
    "t1": 22.7,
    "text": "¡Vamos a descubrirlo!"
   }
  ],
