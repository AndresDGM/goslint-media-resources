   },
   {
    "t0": 26.14,
    "t1": 29.02,
    "text": "Así que no solo importa saber programar."
   },
   {
    "t0": 29.02,
    "t1": 33.42,
    "text": "También necesitas comunicarte, distribuir tareas, tomar decisiones"
   },
   {
    "t0": 33.42,
    "t1": 35.1,
    "text": "y trabajar en equipo…"
   },
   {
    "t0": 35.1,
    "t1": 37.74,
    "text": "todo mientras el reloj sigue avanzando."
   }
  ],
